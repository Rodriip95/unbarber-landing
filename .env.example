# Copiá este archivo como .env.local y completá los valores.
# Todo es público (NEXT_PUBLIC_*): no pongas secretos acá.

# URL de la app (destino de "Registrate gratis" y "Buscar barbero")
NEXT_PUBLIC_APP_URL=https://app.unbarber.com.ar
NEXT_PUBLIC_SITE_URL=https://unbarber.com.ar

# app = el botón lleva al alta de la app · preregistro = formulario propio en la landing
NEXT_PUBLIC_REGISTRO_MODE=app
# espera = lista de espera · abierto = "Buscar barbero" en las zonas abiertas
NEXT_PUBLIC_CLIENTES_MODE=espera
# Barrios donde ya funciona la app, separados por coma (slugs)
NEXT_PUBLIC_ZONAS_ABIERTAS=
NEXT_PUBLIC_ZONA_PILOTO=[zona piloto]

# Membresía: valores por defecto. En producción manda Remote Config
# (membership_price_ars, membership_promo_percent, membership_promo_until).
NEXT_PUBLIC_MEMBERSHIP_PRICE_ARS=20000
NEXT_PUBLIC_MEMBERSHIP_PROMO_PERCENT=100
NEXT_PUBLIC_MEMBERSHIP_PROMO_UNTIL=

# Titular legal (pie de página)
NEXT_PUBLIC_TITULAR=[Titular legal]
NEXT_PUBLIC_CUIT=[CUIT]
NEXT_PUBLIC_CONTACTO_EMAIL=hola@unbarber.com.ar

# Firebase (proyecto compartido con la app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_RECAPTCHA_KEY=

# Píxel de Meta
NEXT_PUBLIC_META_PIXEL_ID=
